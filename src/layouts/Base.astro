---
import SEO from '../components/SEO.astro';
import '../styles/global.css';
const { title, description, path = '/' } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SEO title={title} description={description} path={path} />
    <link rel="alternate" type="application/rss+xml" title="imranemon.tech" href={`${base}rss.xml`} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
  </head>
  <body>
    <header class="site-header">
      <nav>
        <a href={base} class="brand">imranemon<b>.tech</b></a>
        <div class="nav-links">
          <a href={`${base}blog`}>Blog</a>
          <a href={`${base}projects`}>Projects</a>
          <a href={`${base}rss.xml`}>RSS</a>
        </div>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>© {new Date().getFullYear()} Imran Emon · Built with Astro, hosted on GitHub Pages · <a href="https://github.com/shahmddev-sudo/My-Portfolio">Source</a></p>
    </footer>
  </body>
</html>
